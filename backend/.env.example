NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/folio_vault
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false
ATLAS_GRIDFS_BUCKET=folioFiles
ATLAS_FILE_STORAGE_LIMIT_MB=250
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_UPLOAD=10
SMTP_URL=
APP_BASE_URL=http://localhost:5000
TRUST_PROXY=0
