{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/[...path].js": {
      "includeFiles": "{backend/**,node_modules/pdfjs-dist/build/**}"
    }
  },
  "rewrites": [
    { "source": "/vendor/pdfjs/:path*", "destination": "/api/vendor/pdfjs/:path*" }
  ]
}
